# ── Application ──
DEBUG=False
APP_NAME=GST Reconciliation
PORT=8001
HOST=0.0.0.0
ALLOWED_ORIGINS_RAW=http://localhost:8501,http://localhost:8502

# ── MongoDB ──
# Option 1: Local MongoDB
MONGO_URI=mongodb://localhost:27017
# Option 2: MongoDB Atlas (cloud)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=gst_reconciliation

# ── Neo4j (optional — graph features gracefully disabled if not available) ──
# Option 1: Local Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
# Option 2: Neo4j Aura (cloud)
# NEO4J_URI=neo4j+ssc://xxxxxxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_aura_password

# ── Backend URL (used by frontend) ──
BACKEND_URL=http://localhost:8001
