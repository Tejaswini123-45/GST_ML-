# Copy to .env before running Docker Compose.
# Replace the placeholder API key with a long random secret.
DEBUG=False
APP_NAME=GST Reconciliation
PORT=8001
HOST=0.0.0.0
ALLOWED_ORIGINS_RAW=http://localhost:8502

# Docker Compose service hostname (use localhost for running Python outside Docker).
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=gst_reconciliation

# Optional Neo4j. Set these to your Neo4j Aura/local connection details if configured.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Required by Docker Compose; replace before running.
API_KEY=replace-with-a-long-random-secret

# Used by the Streamlit frontend inside Docker Compose.
BACKEND_URL=http://backend:8001
